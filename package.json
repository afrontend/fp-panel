{
  "name": "fp-panel",
  "version": "0.1.6",
  "description": "library for fp-block",
  "homepage": "https://github.com/afrontend",
  "author": {
    "name": "afrontend",
    "email": "autoscripts@gmail.com",
    "url": "https://afrontend.github.io"
  },
  "files": [
    "lib",
    "!lib/__tests__"
  ],
  "main": "lib/index.js",
  "browser": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./testing": "./lib/testing.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "panel"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "jsdoc-to-markdown": "^9.1.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "doc": "{ cat docs/overview.md; echo; jsdoc2md --global-index-format table --heading-depth 3 lib/index.js | sed '/^### Functions$/d'; } > DOCUMENTATION.md",
    "prepublishOnly": "npm run doc && npm test",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afrontend/fp-panel.git"
  },
  "license": "MIT",
  "dependencies": {
    "lodash": "^4.18.1"
  }
}
